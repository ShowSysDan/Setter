# Copy to .env and edit. Switcher IP, input counts, the UDP port and the
# remote syslog server are set in the web UI (Settings) and stored in
# instance/settings.json.

FLASK_ENV=development
SECRET_KEY=change-me

# Optional: require a key on the external /api/v1/ endpoints
# API_KEY=some-long-random-string

# Optional: store settings somewhere other than instance/settings.json
# SETTINGS_FILE=/etc/setter/settings.json

LOG_LEVEL=INFO
