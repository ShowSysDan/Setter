# Copy to .env and edit. Switcher IP, input counts, the UDP port, the UDP
# sender allowlist and the remote syslog server are set in the web UI
# (Settings) and stored in instance/settings.json.
#
# install.sh creates this file for you with FLASK_ENV=production and a random
# SECRET_KEY. Restart the service after changing it: sudo systemctl restart setter

FLASK_ENV=development
SECRET_KEY=change-me

# ---- access control (all optional; see README "Security") -------------------

# Password for the web panel and its internal /api/ (HTTP Basic auth).
# Unset = no login. Set it on anything that is not a closed show network.
# PANEL_USER=setter
# PANEL_PASSWORD=some-long-random-string

# Key required on the external /api/v1/ endpoints (X-API-Key header or ?api_key=).
# API_KEY=some-long-random-string

# Only these addresses / networks may make HTTP requests at all (comma separated).
# ALLOWED_NETWORKS=10.1.1.0/24, 192.168.10.5

# ---- misc -------------------------------------------------------------------

# Optional: store settings somewhere other than instance/settings.json
# SETTINGS_FILE=/etc/setter/settings.json

LOG_LEVEL=INFO
