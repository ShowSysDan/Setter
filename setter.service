# Reference systemd unit. install.sh writes a concrete copy of this to
# /etc/systemd/system/setter.service with the real user and paths filled in.

[Unit]
Description=Setter - ATEM switcher control bridge
After=network-online.target
Wants=network-online.target

[Service]
User=setter
WorkingDirectory=/home/setter/Setter
EnvironmentFile=/home/setter/Setter/.env
# One worker only: the switcher session and the UDP listener live in the process.
# --env wins over anything in .env (systemd lets EnvironmentFile override Environment=).
ExecStart=/home/setter/Setter/venv/bin/gunicorn --workers 1 --threads 4 --env FLASK_ENV=production --bind 0.0.0.0:5000 "app:create_app()"
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
